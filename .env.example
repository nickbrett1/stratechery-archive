# Environment variables for stratechery-archive (docker-container)
# Generated by genproj. Copy to `.env` next to docker-compose.yml and fill in
# real values (genproj never commits secrets).
#
# Keys are derived from the docker-container `envVars` configuration; nothing
# is invented here.

# Vendored msgvault REST client (optional; the mirror reads msgvault.db
# directly). Only needed for metadata cross-checks.
MSGVAULT_URL=http://msgvault:8080
MSGVAULT_TOKEN=
